@model Paged<AuditRow>
@{
    ViewData["Title"] = "Audit log";
    ViewData["Section"] = "audit";
    Func<int, string> PageUrl = p => "/admin/audit?page=" + p;
}
<section class="card">
    <p class="hint" style="margin-bottom:12px">Every admin change: customers, credits, codes (never the code itself), prizes, allocations, deliveries and settings.</p>
    @if (Model.Items.Count == 0)
    {
        <p class="empty">No admin actions recorded yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data stack">
                <thead><tr><th>Time</th><th>Admin</th><th>Action</th><th>Target</th><th>Details</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Items)
                    {
                        var link = a.TargetType switch { "Customer" => $"/admin/customers/{a.TargetId}", "WheelItem" when a.TargetId is not null => $"/admin/prizes/{a.TargetId}/edit", _ => null };
                        <tr>
                            <td data-label="Time" class="mono">@CairoTime.Format(a.CreatedAtUtc, "dd MMM yyyy HH:mm:ss")</td>
                            <td data-label="Admin">@a.AdminName</td>
                            <td data-label="Action"><span class="badge badge-muted">@a.Action</span></td>
                            <td data-label="Target">@if (link is not null) { <a href="@link">@a.TargetType #@a.TargetId</a> } else { @a.TargetType }</td>
                            <td data-label="Details" class="mono" style="max-width:420px;word-break:break-word">@a.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="margin-top:14px"><partial name="_Pager" model="(Model.Page, Model.Pages, Model.Total, PageUrl)" /></div>
    }
</section>
