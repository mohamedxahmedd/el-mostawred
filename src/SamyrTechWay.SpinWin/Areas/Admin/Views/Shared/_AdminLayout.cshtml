@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var section = ViewData["Section"] as string ?? "";
    var name = User.FindFirst(AppClaims.DisplayName)?.Value ?? "المدير";
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    string Current(string s) => s == section ? "page" : "false";
    var nav = new (string Key, string Href, string Icon, string Label)[]
    {
        ("dashboard", "/admin", "layout-dashboard", "لوحة التحكم"),
        ("customers", "/admin/customers", "users", "العملاء"),
        ("prizes", "/admin/prizes", "gift", "الجوائز والنسب"),
        ("spins", "/admin/spins", "dices", "سجل اللفّات"),
        ("awards", "/admin/awards", "package", "الجوائز المكتسبة"),
        ("settings", "/admin/settings", "settings", "الإعدادات"),
        ("audit", "/admin/audit", "scroll-text", "سجل العمليات"),
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0b0f" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content="@csrf" />
    <title>@(section == "dashboard" ? "" : ViewData["Title"] + " · ")لوحة التحكم · SAMYR TECH WAY</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/brand/derived/logo-32.png" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <a class="skip-link" href="#admin-content">انتقل إلى المحتوى</a>
    <partial name="_InsecureBanner" model="@(new Localizer("ar"))" />
    <div class="admin-shell">
        <nav class="sidebar" id="sidebar" aria-label="القائمة الرئيسية">
            <a class="sidebar-brand" href="/admin">
                <span class="logo-plaque logo-plaque--mark"><img src="~/assets/brand/derived/logo-180.png" alt="" width="48" height="48" /></span>
                <span><strong>SAMYR TECH WAY</strong><span>إدارة Spin &amp; Win</span></span>
            </a>
            @foreach (var n in nav)
            {
                <a class="nav-link" href="@n.Href" aria-current="@Current(n.Key)"><partial name="_Icon" model="@n.Icon" /> @n.Label</a>
            }
            <div class="sidebar-foot">
                <a class="nav-link" href="/" target="_blank" rel="noopener"><partial name="_Icon" model="@("external-link")" /> موقع العملاء</a>
                <a class="nav-link" href="/admin/account/password" aria-current="@Current("password")"><partial name="_Icon" model="@("key-round")" /> تغيير كلمة المرور</a>
                <form method="post" asp-antiforgery="true" action="/admin/logout">
                    <button type="submit" class="nav-link"><partial name="_Icon" model="@("log-out")" /> تسجيل الخروج</button>
                </form>
            </div>
        </nav>
        <div class="scrim" id="scrim" hidden></div>
        <div class="admin-main">
            <header class="topbar">
                <button type="button" class="btn btn-ghost btn-icon menu-btn" id="menu-btn" aria-controls="sidebar" aria-expanded="false" aria-label="فتح القائمة"><partial name="_Icon" model="@("menu")" /></button>
                <h1>@ViewData["Title"]</h1>
                <span class="who">مسجّل الدخول باسم <strong>@name</strong></span>
            </header>
            <main class="admin-content" id="admin-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="toasts" id="toasts" role="status" aria-live="polite"
         data-toast="@TempData["toast"]" data-toast-kind="@TempData["toastKind"]"></div>
    <dialog class="modal" id="confirm-dialog" aria-labelledby="confirm-title">
        <div class="panel modal-body confirm-body">
            <h2 id="confirm-title">هل أنت متأكد؟</h2>
            <p class="muted" id="confirm-text"></p>
            <div class="confirm-actions">
                <button type="button" class="btn" value="cancel" id="confirm-cancel">إلغاء</button>
                <button type="button" class="btn btn-primary" value="ok" id="confirm-ok">تأكيد</button>
            </div>
        </div>
    </dialog>
    <script type="module" src="~/js/admin/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
