@model (int Page, int Pages, int Total, Func<int, string> Url)
<nav class="pager" aria-label="Pagination">
    <span>@Model.Total.ToString("N0") result@(Model.Total == 1 ? "" : "s") · page @Model.Page of @Model.Pages</span>
    <span class="pager-links">
        @if (Model.Page > 1)
        {
            <a class="btn btn-sm" href="@Model.Url(Model.Page - 1)" rel="prev"><partial name="_Icon" model="@("chevron-left")" /> Previous</a>
        }
        @if (Model.Page < Model.Pages)
        {
            <a class="btn btn-sm" href="@Model.Url(Model.Page + 1)" rel="next">Next <partial name="_Icon" model="@("chevron-right")" /></a>
        }
    </span>
</nav>
