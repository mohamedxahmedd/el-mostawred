@model CustomerState
@switch (Model)
{
    case CustomerState.Eligible:
        <span class="badge badge-ok">@AdminText.State(Model)</span>
        break;
    case CustomerState.Finished:
        <span class="badge badge-muted">@AdminText.State(Model)</span>
        break;
    default:
        <span class="badge badge-bad">@AdminText.State(Model)</span>
        break;
}
