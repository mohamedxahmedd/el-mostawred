@model ChangePasswordForm
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    ViewData["Section"] = "password";
}
<form class="card" method="post" asp-antiforgery="true" action="/admin/account/password" style="max-width:560px" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
    <div class="field">
        <label class="label" asp-for="CurrentPassword"></label>
        <input class="input" asp-for="CurrentPassword" autocomplete="current-password" />
        <span class="field-error" asp-validation-for="CurrentPassword"></span>
    </div>
    <div class="field">
        <label class="label" asp-for="NewPassword"></label>
        <input class="input" asp-for="NewPassword" autocomplete="new-password" />
        <span class="hint">12 حرفًا على الأقل، وتحتوي على حرف إنجليزي كبير وحرف صغير ورقم.</span>
        <span class="field-error" asp-validation-for="NewPassword"></span>
    </div>
    <div class="field">
        <label class="label" asp-for="ConfirmPassword"></label>
        <input class="input" asp-for="ConfirmPassword" autocomplete="new-password" />
        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
    </div>
    <div class="form-actions"><button type="submit" class="btn btn-primary">تحديث كلمة المرور</button></div>
</form>
