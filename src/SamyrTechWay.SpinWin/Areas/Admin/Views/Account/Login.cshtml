@model AdminLoginForm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تسجيل دخول المدير";
}
<form class="panel auth-card" method="post" asp-antiforgery="true" action="/admin/login" novalidate>
    <span class="logo-plaque"><img src="~/assets/brand/derived/logo-180.png" alt="SAMYR TECH WAY" width="108" height="108" /></span>
    <h1>تسجيل دخول المدير</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label class="label" asp-for="Email">البريد الإلكتروني</label>
        <input class="input" asp-for="Email" type="email" dir="ltr" autocomplete="username" autofocus />
        <span class="field-error" asp-validation-for="Email"></span>
    </div>
    <div class="field">
        <label class="label" asp-for="Password">كلمة المرور</label>
        <input class="input" asp-for="Password" autocomplete="current-password" />
        <span class="field-error" asp-validation-for="Password"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-block">تسجيل الدخول</button>
    <p class="hint" style="text-align:center">لا يوجد تسجيل عام للحسابات. حسابات المدير تُنشأ من إعدادات الخادم الآمنة.</p>
</form>
