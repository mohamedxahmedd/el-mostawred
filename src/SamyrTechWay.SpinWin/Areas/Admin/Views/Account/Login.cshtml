@model AdminLoginForm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Admin sign in";
}
<form class="panel auth-card" method="post" asp-antiforgery="true" action="/admin/login" novalidate>
    <span class="logo-plaque"><img src="~/assets/brand/derived/logo-180.png" alt="SAMYR TECH WAY" width="108" height="108" /></span>
    <h1>Admin sign in</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label class="label" asp-for="Email">Email</label>
        <input class="input" asp-for="Email" type="email" autocomplete="username" autofocus />
        <span class="field-error" asp-validation-for="Email"></span>
    </div>
    <div class="field">
        <label class="label" asp-for="Password">Password</label>
        <input class="input" asp-for="Password" autocomplete="current-password" />
        <span class="field-error" asp-validation-for="Password"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    <p class="hint" style="text-align:center">There is no public registration. Admin accounts are provisioned from secure server configuration.</p>
</form>
