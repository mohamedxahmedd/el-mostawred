@model PrizesViewModel
@{
    ViewData["Title"] = "الجوائز والنسب";
    ViewData["Section"] = "prizes";
    var odds = Model.Odds;
}
<div class="page-actions">
    <h2>عناصر العجلة</h2>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
        <a class="btn btn-primary" href="/admin/prizes/create"><partial name="_Icon" model="@("plus")" /> إضافة جائزة</a>
        <a class="btn" href="/admin/prizes/create?kind=TryAgain"><partial name="_Icon" model="@("rotate-ccw")" /> إضافة عنصر «حاول مرة أخرى»</a>
    </div>
</div>

@if (odds.Status == WheelStatus.InvalidAllocation)
{
    <div class="alert alert-error" role="alert"><partial name="_Icon" model="@("triangle-alert")" /><span><strong>اللفّات متوقفة:</strong> مجموع نسب العناصر المفعّلة <bdi dir="ltr">@WheelItemAdminService.Percent(odds.ConfiguredTotal)</bdi>. اضبطها بالأسفل لتصبح <bdi dir="ltr">100.00%</bdi> بالضبط.</span></div>
}
else if (odds.Status == WheelStatus.NoEligiblePrize)
{
    <div class="alert alert-error" role="alert"><partial name="_Icon" model="@("triangle-alert")" /><span><strong>اللفّات متوقفة:</strong> لا توجد جائزة حقيقية مفعّلة ومتوفرة في المخزون. زوّد المخزون أو فعّل جائزة. (عنصر «حاول مرة أخرى» وحده لا يكفي لتشغيل العجلة.)</span></div>
}

<div class="grid-2">
    <form class="card" method="post" asp-antiforgery="true" action="/admin/prizes/allocation" id="allocation-form" novalidate data-busy-form>
        <div class="card-head">
            <h2>توزيع النسب</h2>
            <span class="hint">مجموع نسب العناصر المفعّلة يجب أن يساوي <bdi dir="ltr">100.00%</bdi></span>
        </div>
        <div class="alloc-total" id="alloc-total" data-valid="@(odds.ConfiguredTotal == WheelOdds.FullAllocation ? "true" : "false")">
            <span class="muted">مجموع المفعّل</span>
            <strong id="alloc-sum" dir="ltr">@WheelItemAdminService.Percent(odds.ConfiguredTotal)</strong>
            <span class="alloc-bar" aria-hidden="true"><span id="alloc-bar" style="width:@Math.Min(100, odds.ConfiguredTotal / 100.0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
            <span class="hint" id="alloc-msg" aria-live="polite"></span>
        </div>
        <div class="table-wrap" style="margin-top:14px">
            <table class="data stack">
                <thead><tr><th>العنصر</th><th>مفعّل</th><th class="num">النسبة %</th><th class="num">النسبة الفعلية الآن</th><th class="num">المخزون</th><th class="num">الترتيب</th><th><span class="sr-only">إجراءات</span></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.Live.Count; i++)
                    {
                        var row = Model.Live[i];
                        var it = row.Item;
                        <tr>
                            <td data-label="العنصر">
                                <input type="hidden" name="Rows[@i].Id" value="@it.Id" />
                                <div class="item-cell">
                                    <span class="thumb">
                                        @if (it.ImageId is not null) { <img src="@WheelPresenter.ImageUrl(it.ImageId)" alt="" loading="lazy" /> }
                                        else { <svg class="icon icon-lg"><use href="/assets/icons/ui.svg#p-@WheelPresenter.Icon(it.IconKey, it.Kind)"></use></svg> }
                                    </span>
                                    <span>
                                        <a class="strong" href="/admin/prizes/@it.Id/edit">@AdminText.Name(it.NameEn, it.NameAr)</a>
                                        <small>@(it.Kind == WheelItemKind.TryAgain ? "حاول مرة أخرى · تُعيد اللفّة" : AdminText.Tier(it.CelebrationTier))@(it.NameAr is null ? "" : $" · {it.NameAr}")</small>
                                    </span>
                                </div>
                            </td>
                            <td data-label="مفعّل">
                                <label class="check"><input type="checkbox" name="Rows[@i].IsActive" value="true" @(it.IsActive ? "checked" : "") data-alloc-active /><span class="switch" aria-hidden="true"></span><span class="sr-only">مفعّل</span></label>
                                <input type="hidden" name="Rows[@i].IsActive" value="false" />
                            </td>
                            <td data-label="النسبة %" class="num">
                                <input class="input pct-input" name="Rows[@i].Percent" type="number" min="0" max="100" step="0.01" inputmode="decimal"
                                       value="@((it.ProbabilityBasisPoints / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-alloc-pct aria-label="نسبة الفوز لـ @AdminText.Name(it.NameEn, it.NameAr)" />
                            </td>
                            <td data-label="النسبة الفعلية الآن" class="num">
                                @if (row.Eligible) { <span class="strong"><bdi dir="ltr">@WheelPresenter.FormatPercent(row.EffectiveProbability)</bdi></span> }
                                else if (it.IsActive && !(it.Kind == WheelItemKind.TryAgain || it.StockQuantity is null || it.StockQuantity > 0)) { <span class="badge badge-bad">نفد المخزون</span> }
                                else { <span class="dim">—</span> }
                            </td>
                            <td data-label="المخزون" class="num">
                                @if (it.Kind == WheelItemKind.TryAgain) { <span class="dim">لا ينطبق</span> }
                                else if (it.StockQuantity is null) { <span class="dim">غير محدود</span> }
                                else { <span class="@(row.LowStock ? "badge badge-warn" : "")">@it.StockQuantity</span> }
                            </td>
                            <td data-label="الترتيب" class="num"><input class="input order-input" name="Rows[@i].DisplayOrder" type="number" min="0" max="999" value="@it.DisplayOrder" aria-label="ترتيب العرض لـ @AdminText.Name(it.NameEn, it.NameAr)" /></td>
                            <td data-label="">
                                <a class="btn btn-xs" href="/admin/prizes/@it.Id/edit" aria-label="تعديل @AdminText.Name(it.NameEn, it.NameAr)" title="تعديل"><partial name="_Icon" model="@("pencil")" /></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Live.Count == 0)
        {
            <p class="empty">لا توجد عناصر على العجلة بعد. أضف الجوائز، ثم فعّلها من هنا.</p>
        }
        else
        {
            <div class="form-actions" style="margin-top:14px">
                <button type="submit" class="btn btn-primary" id="alloc-save"><partial name="_Icon" model="@("check")" /> حفظ توزيع النسب</button>
            </div>
        }
    </form>

    <section class="card" aria-labelledby="preview-title">
        <div class="card-head"><h2 id="preview-title">معاينة العجلة الحالية</h2><span class="hint">النسب الفعلية بعد استبعاد ما نفد مخزونه</span></div>
        @if (Model.Preview.Count == 0)
        {
            <p class="empty">العجلة غير جاهزة للّف بعد، لذلك لا توجد معاينة.</p>
        }
        else
        {
            <div class="preview-wheel" dir="ltr">
                <div class="wheel-disc" id="preview-disc"></div>
                <svg class="wheel-frame" id="preview-frame" viewBox="-500 -500 1000 1000" aria-hidden="true"></svg>
                <svg class="preview-pointer" viewBox="0 0 100 130" aria-hidden="true"><path d="M50 128 C34 92 10 70 10 44 A40 40 0 0 1 90 44 C90 70 66 92 50 128Z" fill="#ffd06b" stroke="#5a3204" stroke-width="3" /><circle cx="50" cy="44" r="16" fill="#d01518" stroke="#fff1c2" stroke-width="3" /></svg>
            </div>
            <ul class="legend-list" style="list-style:none;padding:0;margin:14px 0 0;display:grid;gap:6px">
                @foreach (var p in Model.Preview)
                {
                    <li style="display:flex;justify-content:space-between;gap:10px;font-size:14px"><span><span class="badge swatch-@p.Color" style="width:12px;height:12px;padding:0;border-radius:4px"></span> @p.Name</span><span class="strong"><bdi dir="ltr">@WheelPresenter.FormatPercent(Model.Odds.ProbabilityOf(p.Id))</bdi></span></li>
                }
            </ul>
            <script type="application/json" id="preview-data">@Json.Serialize(Model.Preview)</script>
        }
    </section>
</div>

@if (Model.Archived.Count > 0)
{
    <section class="card">
        <div class="card-head"><h2>المؤرشفة</h2><span class="hint">محفوظة للسجل فقط، ولا تظهر على العجلة</span></div>
        <div class="table-wrap">
            <table class="data stack">
                <thead><tr><th>العنصر</th><th class="num">مرات الفوز</th><th><span class="sr-only">إجراءات</span></th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Archived)
                    {
                        <tr>
                            <td data-label="العنصر">@AdminText.Name(row.Item.NameEn, row.Item.NameAr) <span class="dim">(@AdminText.Kind(row.Item.Kind))</span></td>
                            <td data-label="مرات الفوز" class="num">@row.Wins</td>
                            <td data-label="">
                                <form method="post" asp-antiforgery="true" action="/admin/prizes/@row.Item.Id/restore"><button type="submit" class="btn btn-xs"><partial name="_Icon" model="@("archive-restore")" /> استعادة</button></form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@section Scripts {
    <script type="module" src="~/js/admin/prizes.js" asp-append-version="true"></script>
}
