@model WheelItemForm
@{
    var isNew = Model.Id is null;
    var retry = Model.Kind == WheelItemKind.TryAgain;
    var lose = Model.Kind == WheelItemKind.Lose;
    var noPrize = retry || lose; // no stock, tier or pickup note
    ViewData["Title"] = isNew ? (retry ? "عنصر «حاول مرة أخرى» جديد" : lose ? "شريحة «حظ أوفر» جديدة" : "جائزة جديدة") : $"تعديل {AdminText.Name(Model.NameEn, Model.NameAr)}";
    ViewData["Section"] = "prizes";
    var action = isNew ? "/admin/prizes/create" : $"/admin/prizes/{Model.Id}/edit";
}
<form class="card" method="post" asp-antiforgery="true" action="@action" enctype="multipart/form-data" novalidate data-busy-form>
    <input type="hidden" asp-for="RowVersion" />
    <input type="hidden" asp-for="Kind" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert" style="margin-bottom:16px"></div>
    @if (retry)
    {
        <p class="alert alert-info" style="margin-bottom:16px"><partial name="_Icon" model="@("info")" /><span>«حاول مرة أخرى» ليست جائزة. عندما تقف عليها العجلة تُسترد اللفّة المستخدمة في نفس العملية ويستطيع العميل اللفّ مرة أخرى. ليس لها مخزون ولا تُسجَّل كجائزة مكتسبة. يمكن تفعيل عنصر واحد فقط من نوع «حاول مرة أخرى».</span></p>
    }
    @if (lose)
    {
        <p class="alert alert-info" style="margin-bottom:16px"><partial name="_Icon" model="@("info")" /><span>«حظ أوفر» شريحة خسارة: عندما تقف عليها العجلة تُخصم اللفّة ولا يكسب العميل شيئًا. ليس لها مخزون ولا تُسجَّل كجائزة مكتسبة. لا تعمل العجلة إلا إذا كانت هناك جائزة حقيقية واحدة على الأقل متاحة.</span></p>
    }
    <div class="form-grid">
        <p class="section-title span-2">الاسم والوصف</p>
        <div class="field"><label class="label" asp-for="NameEn"></label><input class="input" asp-for="NameEn" dir="ltr" lang="en" /><span class="field-error" asp-validation-for="NameEn"></span></div>
        <div class="field"><label class="label" asp-for="NameAr"></label><input class="input" asp-for="NameAr" dir="rtl" lang="ar" /><span class="field-error" asp-validation-for="NameAr"></span></div>
        <div class="field"><label class="label" asp-for="DescriptionEn"></label><input class="input" asp-for="DescriptionEn" dir="ltr" lang="en" /><span class="field-error" asp-validation-for="DescriptionEn"></span></div>
        <div class="field"><label class="label" asp-for="DescriptionAr"></label><input class="input" asp-for="DescriptionAr" dir="rtl" lang="ar" /><span class="field-error" asp-validation-for="DescriptionAr"></span></div>

        <p class="section-title span-2">النسبة والتوفر</p>
        <div class="field">
            <label class="label" asp-for="WeightPercent"></label>
            <input class="input" asp-for="WeightPercent" type="number" min="0" max="100" step="0.01" inputmode="decimal" />
            <span class="hint">@(Model.Id is null
                ? "العناصر الجديدة تبدأ عادةً غير مفعّلة: فعّلها معًا من جدول توزيع النسب، حيث يجب أن يكون مجموع نسب العناصر المفعّلة 100.00%."
                : Model.Kind != WheelItemKind.TryAgain
                    ? "مجموع نسب العناصر المفعّلة دائمًا 100.00%: عند تغيير هذه النسبة، يأخذ عنصر «حاول مرة أخرى» الفرق تلقائيًا. لتغيير أكثر من نسبة معًا، استخدم جدول توزيع النسب."
                    : "مجموع نسب العناصر المفعّلة يجب أن يكون 100.00%. لتغيير نسبة «حاول مرة أخرى»، استخدم جدول توزيع النسب في صفحة الجوائز.")</span>
            <span class="field-error" asp-validation-for="WeightPercent"></span>
        </div>
        <div class="field">
            <label class="label" asp-for="DisplayOrder"></label>
            <input class="input" asp-for="DisplayOrder" type="number" min="0" max="999" />
            <span class="field-error" asp-validation-for="DisplayOrder"></span>
        </div>
        @if (!noPrize)
        {
            <div class="field">
                <label class="label" asp-for="StockQuantity"></label>
                <input class="input" asp-for="StockQuantity" type="number" min="0" placeholder="غير محدود" />
                <span class="hint">يُحجز من المخزون لحظة فوز العميل. عندما يصل إلى 0 تخرج الجائزة من العجلة تلقائيًا.</span>
                <span class="field-error" asp-validation-for="StockQuantity"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="LowStockThreshold"></label>
                <input class="input" asp-for="LowStockThreshold" type="number" min="0" max="1000" />
                <span class="field-error" asp-validation-for="LowStockThreshold"></span>
            </div>
        }
        <div class="field span-2">
            <label class="check"><input type="checkbox" asp-for="IsActive" /><span class="switch" aria-hidden="true"></span> مفعّلة على العجلة</label>
            <span class="field-error" asp-validation-for="IsActive"></span>
        </div>

        <p class="section-title span-2">الشكل وطريقة الظهور</p>
        <div class="field span-2">
            <span class="label">الصورة</span>
            <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
                <div class="image-preview" id="image-preview">
                    @if (Model.CurrentImageUrl is not null) { <img src="@Model.CurrentImageUrl" alt="الصورة الحالية" /> }
                    else { <span class="hint">لا توجد صورة</span> }
                </div>
                <div style="display:grid;gap:8px">
                    <input class="input" asp-for="Image" type="file" accept="image/jpeg,image/png,image/webp" style="min-height:auto;padding:10px" />
                    <span class="hint">JPEG أو PNG أو WebP بحد أقصى 2 ميجابايت. الصور المربعة تظهر بشكل أفضل. بدون صورة تُستخدم الأيقونة.</span>
                    @if (Model.CurrentImageUrl is not null)
                    {
                        <label class="check"><input type="checkbox" asp-for="RemoveImage" /><span class="switch" aria-hidden="true"></span> حذف الصورة الحالية</label>
                    }
                    <span class="field-error" asp-validation-for="Image"></span>
                </div>
            </div>
        </div>
        <fieldset class="field span-2" style="border:0;padding:0;margin:0">
            <legend class="label" style="margin-bottom:8px">أيقونة جاهزة</legend>
            <div class="icon-picker">
                @foreach (var (key, label) in PrizeIcons.All)
                {
                    <label><input type="radio" name="IconKey" value="@key" @(Model.IconKey == key ? "checked" : "") /><span class="opt"><svg class="icon"><use href="/assets/icons/ui.svg#p-@key"></use></svg>@label</span></label>
                }
            </div>
            <span class="field-error" asp-validation-for="IconKey"></span>
        </fieldset>
        <fieldset class="field span-2" style="border:0;padding:0;margin:0">
            <legend class="label" style="margin-bottom:8px">لون الشريحة</legend>
            <div class="color-picker">
                @foreach (var key in WheelItemAdminService.ColorKeys)
                {
                    <label><input type="radio" name="ColorKey" value="@key" @(Model.ColorKey == key ? "checked" : "") /><span class="sw"><i class="swatch-@key"></i>@(key switch { "ruby" => "أحمر ياقوتي", "flame" => "لهبي", "ember" => "جمري", "amber" => "كهرماني", "gold" => "ذهبي", "onyx" => "أسود", _ => key })</span></label>
                }
            </div>
        </fieldset>
        @if (!noPrize)
        {
            <div class="field">
                <label class="label" asp-for="Tier"></label>
                <select class="select" asp-for="Tier">
                    <option value="Standard">@AdminText.Tier(CelebrationTier.Standard) — توهج خفيف وقصاصات ملوّنة</option>
                    <option value="Rare">@AdminText.Tier(CelebrationTier.Rare) — شرارات ذهبية وإضاءة مركّزة وأجراس</option>
                    <option value="Epic">@AdminText.Tier(CelebrationTier.Epic) — انفجار نار العنقاء وأشعة وموسيقى احتفالية</option>
                </select>
            </div>
            <div></div>
            <div class="field"><label class="label" asp-for="CollectionNoteEn"></label><textarea class="textarea" asp-for="CollectionNoteEn" dir="ltr" lang="en" rows="2" placeholder="اتركها فارغة لاستخدام تعليمات الاستلام الافتراضية"></textarea></div>
            <div class="field"><label class="label" asp-for="CollectionNoteAr"></label><textarea class="textarea" asp-for="CollectionNoteAr" rows="2" dir="rtl" lang="ar"></textarea></div>
        }
    </div>
    <div class="form-actions" style="margin-top:20px">
        @if (!isNew && !Model.IsActive)
        {
            <button type="submit" class="btn btn-danger" form="archive-form"><partial name="_Icon" model="@("archive")" /> أرشفة</button>
        }
        <a class="btn btn-ghost" href="/admin/prizes">إلغاء</a>
        <button type="submit" class="btn btn-primary">@(isNew ? "إضافة العنصر" : "حفظ التغييرات")</button>
    </div>
</form>
@if (!isNew && !Model.IsActive)
{
    <form id="archive-form" method="post" asp-antiforgery="true" action="/admin/prizes/@Model.Id/archive" data-confirm="أرشفة هذا العنصر؟ سيختفي من قائمة الإدارة ومن العجلة، لكن كل اللفّات والجوائز المكتسبة السابقة تبقى محفوظة في السجل."></form>
}
