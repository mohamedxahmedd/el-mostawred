@model SpinDetailsViewModel
@{
    var a = Model.Attempt;
    ViewData["Title"] = "لفّة " + a.Id.ToString()[..8];
    ViewData["Section"] = "spins";
}
<div class="page-actions"><a class="btn btn-ghost btn-sm" href="/admin/spins"><partial name="_Icon" model="@("arrow-right")" /> كل اللفّات</a></div>
<div class="grid-2-even">
    <section class="card">
        <div class="card-head"><h2>النتيجة</h2><span class="badge @(a.Kind == SpinResultKind.Won ? "badge-flame" : "badge-muted")">@(a.Kind switch { SpinResultKind.Won => "فوز بجائزة", SpinResultKind.Lost => "حظ أوفر (خُصمت اللفّة بدون جائزة)", _ => AdminText.Result(a.Kind) + " (تم استرداد اللفّة)" })</span></div>
        <dl class="dl">
            <dt>الوقت (توقيت القاهرة)</dt><dd>@AdminText.Date(a.CreatedAtUtc, "dddd d MMM yyyy، HH:mm:ss")</dd>
            <dt>الوقت (UTC)</dt><dd class="mono"><bdi dir="ltr">@a.CreatedAtUtc.ToString("u")</bdi></dd>
            <dt>العميل</dt><dd><a href="/admin/customers/@Model.Customer.Id"><bdi>@Model.Customer.FullName</bdi></a> · <bdi dir="ltr" class="mono">@PhoneNumber.Mask(Model.Customer.NormalizedPhone)</bdi></dd>
            <dt>الفاتورة</dt><dd><bdi dir="ltr">@(Model.Customer.InvoiceReference ?? "—")</bdi></dd>
            <dt>الشريحة (كما كانت وقت اللفّة)</dt><dd><bdi>@a.ItemNameEn</bdi>@if (a.ItemNameAr is not null) {<text> · <bdi>@a.ItemNameAr</bdi></text>} <partial name="_Tier" model="a.CelebrationTier" /></dd>
            <dt>رصيد اللفّات (قبل ← بعد)</dt><dd>@a.CreditsBefore ← @a.CreditsAfter</dd>
            <dt>النسبة المحددة</dt><dd><bdi dir="ltr">@WheelItemAdminService.Percent(a.ConfiguredBasisPoints)</bdi></dd>
            <dt>النسبة الفعلية</dt><dd><bdi dir="ltr">@a.EffectiveWeight</bdi> من <bdi dir="ltr">@a.EffectiveTotalWeight</bdi> (<bdi dir="ltr">@WheelPresenter.FormatPercent(a.EffectiveTotalWeight == 0 ? 0 : (double)a.EffectiveWeight / a.EffectiveTotalWeight)</bdi>)</dd>
            <dt>رقم المحاولة</dt><dd class="mono"><bdi dir="ltr">@a.Id</bdi></dd>
            <dt>مفتاح الطلب</dt><dd class="mono"><bdi dir="ltr">@a.RequestId</bdi></dd>
        </dl>
    </section>
    <section class="card">
        <div class="card-head"><h2>الجائزة المكتسبة</h2></div>
        @if (Model.Award is { } aw)
        {
            <dl class="dl">
                <dt>الجائزة</dt><dd><bdi>@AdminText.Name(aw.PrizeNameEn, aw.PrizeNameAr)</bdi></dd>
                <dt>الحالة</dt><dd><span class="badge @(aw.Status == AwardStatus.Delivered ? "badge-ok" : "badge-warn")">@AdminText.Status(aw.Status)</span></dd>
                <dt>التسليم</dt><dd>@if (aw.DeliveredAtUtc is { } d) {<text>@AdminText.Date(d) بواسطة <bdi>@aw.DeliveredByAdminName</bdi></text>} else {<text>—</text>}</dd>
                <dt>ملاحظة</dt><dd>@(aw.AdminNote ?? "—")</dd>
            </dl>
            @if (aw.Status == AwardStatus.Pending)
            {
                <form method="post" asp-antiforgery="true" action="/admin/awards/@aw.Id/deliver" style="margin-top:16px;display:grid;gap:10px" data-confirm="تأكيد تسليم هذه الجائزة؟">
                    <input type="hidden" name="returnUrl" value="/admin/spins/@a.Id" />
                    <input class="input" name="note" maxlength="500" placeholder="ملاحظة اختيارية (مثلًا: تم الاستلام من الفرع)" />
                    <button type="submit" class="btn btn-gold"><partial name="_Icon" model="@("check")" /> تأكيد التسليم</button>
                </form>
            }
        }
        else
        {
            <p class="empty">@(a.Kind == SpinResultKind.Lost ? "نتيجة «حظ أوفر» لا تُنشئ جائزة مكتسبة، وتُخصم اللفّة." : "نتيجة «حاول مرة أخرى» لا تُنشئ جائزة مكتسبة. تم استرداد لفّة العميل في نفس العملية.")</p>
        }
    </section>
</div>
