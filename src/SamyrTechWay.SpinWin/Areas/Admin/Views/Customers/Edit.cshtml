@model CustomerForm
@{
    ViewData["Title"] = "Edit customer";
    ViewData["Section"] = "customers";
    var id = (int)ViewData["CustomerId"]!;
}
<form class="card" method="post" asp-antiforgery="true" action="/admin/customers/@id/edit" novalidate data-busy-form>
    <input type="hidden" asp-for="RowVersion" />
    <partial name="_CustomerFields" model="Model" view-data="ViewData" />
    <div class="form-actions" style="margin-top:18px">
        <a class="btn btn-ghost" href="/admin/customers/@id">Cancel</a>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>
