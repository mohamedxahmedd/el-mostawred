@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
    ViewData["Section"] = "customers";
    var f = Model.Filter;
    string PageUrl(int p) => $"/admin/customers?Q={Uri.EscapeDataString(f.Q ?? "")}&Status={f.Status}&WithCredits={f.WithCredits.ToString().ToLowerInvariant()}&Page={p}";
}
<div class="page-actions">
    <h2>Buyers</h2>
    <a class="btn btn-primary" href="/admin/customers/create"><partial name="_Icon" model="@("user-plus")" /> Add customer</a>
</div>

<form class="filters card" method="get" action="/admin/customers" role="search">
    <div class="field grow">
        <label class="label" for="q">Search</label>
        <input class="input" id="q" name="Q" value="@f.Q" placeholder="Name, phone or invoice" />
    </div>
    <div class="field">
        <label class="label" for="status">Status</label>
        <select class="select" id="status" name="Status">
            <option value="all" selected="@(f.Status is null or "all")">All</option>
            <option value="active" selected="@(f.Status == "active")">Active</option>
            <option value="disabled" selected="@(f.Status == "disabled")">Disabled</option>
        </select>
    </div>
    <label class="check" style="min-height:44px"><input type="checkbox" name="WithCredits" value="true" @(f.WithCredits ? "checked" : "") /><span class="switch" aria-hidden="true"></span> Has credits</label>
    <button type="submit" class="btn"><partial name="_Icon" model="@("search")" /> Filter</button>
</form>

<section class="card">
    @if (Model.Result.Items.Count == 0)
    {
        <p class="empty">@(string.IsNullOrWhiteSpace(f.Q) && f.Status is null or "all" && !f.WithCredits ? "No customers yet. Add the first buyer to issue their spin credit and access code." : "No customers match these filters.")</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data stack">
                <thead><tr><th>Name</th><th>Phone</th><th>Invoice</th><th>Laptop</th><th class="num">Credits</th><th>Status</th><th class="num">Prizes</th><th>Added</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Result.Items)
                    {
                        <tr>
                            <td data-label="Name"><a href="/admin/customers/@c.Id">@c.FullName</a></td>
                            <td data-label="Phone" class="mono">@c.Phone</td>
                            <td data-label="Invoice">@(c.Invoice ?? "—")</td>
                            <td data-label="Laptop">@(c.LaptopModel ?? "—")</td>
                            <td data-label="Credits" class="num strong">@c.Credits</td>
                            <td data-label="Status"><partial name="_CustomerState" model="c.State" /></td>
                            <td data-label="Prizes" class="num">@c.Awards</td>
                            <td data-label="Added" class="mono">@CairoTime.Format(c.CreatedAtUtc, "dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="margin-top:14px"><partial name="_Pager" model="(Model.Result.Page, Model.Result.Pages, Model.Result.Total, (Func<int, string>)PageUrl)" /></div>
    }
</section>
