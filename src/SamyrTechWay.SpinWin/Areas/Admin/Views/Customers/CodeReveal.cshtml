@model AccessCodeReveal
@{
    ViewData["Title"] = Model.IsNew ? "تمت إضافة العميل" : "كود دخول جديد";
    ViewData["Section"] = "customers";
    Context.Response.Headers.CacheControl = "no-store";
}
<section class="card code-reveal">
    <span class="badge badge-ok"><partial name="_Icon" model="@("circle-check")" /> @(Model.IsNew ? "تم حفظ العميل" : "تم إصدار كود جديد")</span>
    <h2 style="font-size:24px">@Model.FullName</h2>
    <p class="muted"><bdi dir="ltr" class="mono">@Model.Phone</bdi> · رصيد اللفّات: @Model.Credits</p>
    <p class="muted">كود الدخول الخاص بالعميل يظهر <strong>الآن فقط</strong>. يتم حفظه مشفّرًا ولا يمكن عرضه مرة أخرى.</p>
    <div class="code-box" id="access-code" dir="ltr">@Model.Code</div>
    @if (!Model.IsNew)
    {
        <p class="alert alert-warn" style="text-align:start"><partial name="_Icon" model="@("info")" /><span>الكود القديم لم يعد يعمل، وتم تسجيل خروج العميل من أي جلسة مفتوحة.</span></p>
    }
    <div class="form-actions" style="justify-content:center">
        <button type="button" class="btn btn-gold" data-copy="#access-code"><partial name="_Icon" model="@("copy")" /> نسخ الكود</button>
        <button type="button" class="btn" data-print><partial name="_Icon" model="@("printer")" /> طباعة الكارت</button>
        <a class="btn btn-primary" href="/admin/customers/@Model.CustomerId">فتح صفحة العميل <partial name="_Icon" model="@("arrow-left")" /></a>
    </div>
    <p class="hint">يسجّل العميل الدخول من <bdi dir="ltr" class="mono">@Model.SiteUrl</bdi> برقم الموبايل وهذا الكود.</p>
</section>

<div class="print-card" aria-hidden="true">
    <div class="pc-head">
        <img src="~/assets/brand/derived/logo-180.png" alt="" />
        <div><div class="pc-title"><bdi dir="ltr">SAMYR TECH WAY · SPIN &amp; WIN</bdi></div><div class="pc-small">شراؤك. لحظتك. مكافأتك.</div></div>
    </div>
    <div class="pc-small">@Model.FullName — <bdi dir="ltr">@Model.Phone</bdi></div>
    <div class="pc-code" dir="ltr">@Model.Code</div>
    <div class="pc-small">ادخل على <bdi dir="ltr">@Model.SiteUrl</bdi> برقم موبايلك وكود الدخول ده. الكود سري، متشاركهوش مع حد.</div>
</div>
