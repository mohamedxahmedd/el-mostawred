@model CustomerForm
@{
    ViewData["Title"] = "Add customer";
    ViewData["Section"] = "customers";
    ViewData["IsCreate"] = true;
}
<form class="card" method="post" asp-antiforgery="true" action="/admin/customers/create" novalidate data-busy-form>
    <p class="muted" style="margin-bottom:18px">After saving, a private access code is generated and shown <strong>once</strong>. Give it to the customer together with the site address.</p>
    <partial name="_CustomerFields" model="Model" view-data="ViewData" />
    <div class="form-actions" style="margin-top:18px">
        <a class="btn btn-ghost" href="/admin/customers">Cancel</a>
        <button type="submit" class="btn btn-primary"><partial name="_Icon" model="@("key-round")" /> Create &amp; generate code</button>
    </div>
</form>
